# GEMINI_API_KEY: Required for Gemini AI API calls (non-diagnostic ISBAR structuring assistant).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for hospital locator & route view.
# Provisioned automatically in AI Studio when Google Maps Platform is enabled.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
